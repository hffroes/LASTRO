# Database
# Auto-injected by Replit Postgres addon when activated in panel
DATABASE_URL="postgresql://user:password@localhost:5432/lastro_dev"

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET="your-secure-random-32-char-secret-here"
JWT_REFRESH_SECRET="your-secure-random-32-char-refresh-secret-here"

# Environment
NODE_ENV="development"

# Server Port (Replit overrides this in production)
PORT=3000

# External Data Adapters
# Options: static (default JSON-based) or http (requires confirmed API)
FIPEZAP_ADAPTER="static"
CUB_ADAPTER="static"

# Frontend
VITE_API_URL=""  # not needed in production (same-origin)
