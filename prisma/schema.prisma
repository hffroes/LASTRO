// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  analyses  Analysis[]
}

model Analysis {
  id                    String     @id @default(cuid())
  userId                String
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Input data snapshot
  areaTerreno           Float
  formatoLote           String     // regular, irregular
  topografia            String     // plana, regular, irregular, acidentada
  valorTerrenoR         Float
  tipologia             String     // Unifamiliar, Multifamiliar, etc
  padrao                String     // Baixo, Normal, Alto
  unidades              Int
  precoVendaUnitario    Float

  // Additional details (JSON to support variable fields per tipology)
  detalhesProto         Json?
  parametrosSnapshot    Json       // snapshot of parameters used at calculation time

  // Output data
  resultado             Json       // AnalysisResult structure

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model ExternalDataCache {
  id        String   @id @default(cuid())
  source    String   // fipezap, cub
  region    String   // MG, etc
  data      Json
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([source, region])
  @@index([source])
}

// Percentuais por tipologia/padrão (PRD §3.1) + referência ao projeto-padrão
// CUB Sinduscon-MG usado no motor de cálculo (Fase 3).
model Tipologia {
  id                 String   @id @default(cuid())
  tipologia          String   // Unifamiliar, Loteamento, Multifamiliar, Galpão, Comercial, Uso Misto
  padrao             String   // Baixo, Normal, Alto
  percentualTerreno  Float    // ex: 0.08 = 8% do VGV
  percentualLucro    Float    // ex: 0.18 = 18% do VGV

  // Referência à tabela CUB Sinduscon-MG (PRD §3.1) e ajuste de complexidade
  // (PRD §3.2-A). Nulos quando o PRD não define o valor — nunca inventado
  // (regra CLAUDE.md #8); ver notaCub para o motivo.
  cubCodigo          String?
  ajusteTipologiaCub Float?
  notaCub            String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tipologia, padrao])
}

// Ajustes de CUB por topografia e formato de lote (PRD §3.2-B/C), aplicados
// a qualquer tipologia — valores fixos, independentes de Tipologia.
model AjusteCub {
  id         String   @id @default(cuid())
  categoria  String   // "topografia" | "formato"
  chave      String   // ex: "plana", "irregular"
  percentual Float    // ex: 0.02 = +2%

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoria, chave])
}

// Parâmetros diversos/TBD armazenados como JSON, centralizados aqui em vez
// de números mágicos espalhados pelo código (regra CLAUDE.md #9). Usado
// hoje para o placeholder de coeficientes de IA (PRD §3.3, ainda não
// definido pelas normas de zoneamento de MG).
model Parametro {
  id        String   @id @default(cuid())
  chave     String   @unique
  valor     Json
  descricao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
